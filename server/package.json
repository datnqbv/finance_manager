{
  "name": "expense-manager-server",
  "version": "1.0.0",
  "description": "Backend for Personal Finance Manager",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "set FORCE_SQLITE_IN_TESTS=true&& node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --coverage",
    "fts:setup": "node scripts/setup_fulltext_indexes.js",
    "fts:reindex": "node scripts/reindex_fulltext.js",
    "db:migrate-wallets": "node scripts/migrate_wallets.js",
    "build:exe": "npx esbuild src/index.js --bundle --platform=node --format=cjs --target=node18 --outfile=bundled.cjs --external:fsevents && pkg bundled.cjs --target node18-win-x64 --no-bytecode --public --output ../dist/QuanLyChiTieu.exe"
    
  },
  "pkg": {
    "scripts": [
      "src/**/*.js"
    ],
    "assets": [
      "node_modules/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ]
  },
  "keywords": [
    "expense",
    "finance",
    "manager"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "csv-parse": "^6.1.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "ml": "^8.0.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.10",
    "sequelize": "^6.32.1",
    "simple-statistics": "^7.8.9",
    "tedious": "^14.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "esbuild": "^0.27.7",
    "jest": "^30.2.0",
    "nodemon": "^3.0.1",
    "sequelize-cli": "^6.6.0",
    "sqlite3": "^5.1.6",
    "supertest": "^7.2.2"
  }
}