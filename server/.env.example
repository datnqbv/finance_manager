# Server environment variables example
# Copy to `.env` and fill real values (do NOT commit secrets)

# Select database type: 'sqlserver'
DB_TYPE=sqlserver

# SQL Server (MSSQL)
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=123456789
SQLSERVER_DATABASE=FinanceManager
SQLSERVER_ENCRYPT=false

# JWT / Auth (examples kept)
JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
